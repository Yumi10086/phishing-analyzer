  "cards": [
    {
      "dot": "cyan",
      "title": "五阶段流水线",
      "items": [
        "解析 → 提取 → 富化 → 评分 → 响应，由 analyze_bytes 单点编排",
        "单封离线分析 2–5 ms，GUI 与 API 共用同一链路"
      ]
    },
    {
      "dot": "emerald",
      "title": "可解释评分",
      "items": [
        "评分规则外置为 YAML，支持在线增删改与热重载",
        "每条结论附带研判依据，报告记录规则版本哈希以复现复盘"
      ]
    },
    {
      "dot": "rose",
      "title": "情报与闭环",
      "items": [
        "三源情报异步并发，SQLite 缓存 24h 规避免费额度限流",
        "高置信告警自动创建 TheHive 工单，完成研判到处置闭环"
      ]
    }
