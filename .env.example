# 情报查询行为
INTEL_TIMEOUT=15
INTEL_CONCURRENCY=8
VT_RATE_LIMIT=4
CACHE_TTL_HOURS=24

# 评分阈值（<30 BENIGN，30-54 SUSPICIOUS，>=55 MALICIOUS）
TH_SUSPICIOUS=30
TH_MALICIOUS=55

# TheHive 工单系统
THEHIVE_URL=
