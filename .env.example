# 威胁情报 API Key（留空则对应情报源自动降级为 no_key，本地分析不受影响）
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
# 主动提交 URLScan 扫描（0=仅被动搜索历史记录，1=允许主动扫描未知 URL）
URLSCAN_ALLOW_SUBMIT=0

# 情报查询行为
INTEL_TIMEOUT=15
INTEL_CONCURRENCY=8
VT_RATE_LIMIT=4
CACHE_TTL_HOURS=24

# 评分阈值（<30 BENIGN，30-54 SUSPICIOUS，>=55 MALICIOUS）
TH_SUSPICIOUS=30
TH_MALICIOUS=55

# TheHive 工单系统
THEHIVE_URL=
THEHIVE_API_KEY=

# ---- 个人邮箱接入（IMAP 只读取信）----
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务 后生成的 16 位授权码（非登录密码）
MAILBOX_IMAP_HOST=imap.qq.com
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_USER=
MAILBOX_IMAP_AUTH_CODE=
# 单封邮件下载上限（字节，默认 20MB；先取 RFC822.SIZE 再决定是否下正文）
MAILBOX_MAX_BYTES=20971520
# 自己投递的信不参与分析（1=开启）；本人其它地址用逗号分隔，用于识别自寄副本
MAILBOX_SKIP_SELF_SENT=1
MAILBOX_OWN_ADDRESSES=

# ---- 分析档位与信任上下文 ----
# gateway=网关/SOC 投递的邮件（默认）；mailbox=邮箱直读取信（取信 CLI 与 GUI 会自动切换）
ANALYSIS_PROFILE=gateway
# 发件人信任上下文：gateway 默认关、mailbox 默认开；=0 关闭做对照
TRUST_CONTEXT=
# 信任门槛：地址封数 / 域级封数 / 域级时间跨度（天）
TRUST_MIN_COUNT=2
TRUST_MIN_DOMAIN_COUNT=5
TRUST_MIN_SPAN_DAYS=14
