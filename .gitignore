# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 运行时数据与生成产物 =====
# data/ 下除合成样本外均为运行时产物（报告、情报缓存、评估语料、批量结果），
# 体积大或可由脚本再生成，不入库；新增语料/评估文件会自动被忽略
data/*
!data/samples/

# ===== 环境变量与密钥 =====
.env
.streamlit/secrets.toml

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log

# ===== 架构图检查截图与工具临时交付快照（保留 architecture.html 与 .architecture.json 源文件）=====
架构图/*visual-check*
架构图/.archify-delivery-*/

# ===== 开发文档与个人待办（不入库）=====
# README_dev.md 是开发日志（迭代史、基线语料约定、被否决的方案、Roadmap 迭代记录等），
# 面向维护者而非使用者；公开仓库只保留面向使用者的 README.md
README_dev.md
代办清单*.md

# ===== 开发期临时分析脚本（会话内的 A/B 探针、基准、一次性归因工具）=====
# 形如 scripts/_ab_*.py / _probe_*.py / _bench_*.py：依赖被忽略的本地语料，不属于
# 文档化的工具链（README 只承诺 scripts/eval_*.py 等评估脚本）
scripts/_*.py

# ===== 测试集 =====
tests/